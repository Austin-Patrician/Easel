# ============================================================
# Easel 环境变量
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# 人工发布模式：automated（允许一键发布）或 manual（只导出人工发布包）
EASEL_PUBLISH_MODE=automated

# Web 服务监听地址（默认只绑本机）
# EASEL_HOST=127.0.0.1
# EASEL_PORT=7860

# pi 是唯一 Agent 底座。模型认证优先用 pi 自己的登录：
#   pi
#   /login
# 也可以填入任意 OpenAI-compatible 服务，Easel 会注册为 pi provider `easel-direct`。
# EASEL_DIRECT_API_KEY=REPLACE_ME
# EASEL_DIRECT_API_BASE_URL=https://your-provider.example/v1
# EASEL_DIRECT_API_MODEL=gpt-4.1
# 可选：API Key 请求头（默认 Authorization: Bearer <key>）
# EASEL_DIRECT_API_KEY_HEADER=api-key

# 媒体生成脚本也可复用 OpenAI-compatible 服务
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 可选：独立向量/Embedding API（不配置则使用关键词记忆检索）
# EASEL_EMBEDDING_API_KEY=REPLACE_ME
# EASEL_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EASEL_EMBEDDING_MODEL=text-embedding-3-small

# 代理（仅用于外部平台抓取和发布；本地 pi 服务不应经过代理）
# EASEL_PROXY=http://127.0.0.1:7890

# 联网搜索：pi 的 web_search / web_extract 工具使用 Tavily
# 获取 Key：https://app.tavily.com
# TAVILY_API_KEY=tvly-...

# ============================================================
# 可选：媒体生成模型（也可在 Web 设置中填写）
# 只需配置实际使用的 provider；密钥留空不会启用。
# ============================================================

# 视频：dashscope / ark / kling / openai-compatible / xhs-maas / agnes
VIDEO_PROVIDER=
# AGNES_API_KEY=
# AGNES_MODEL=agnes-video-2.5-flash
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# AI 音乐：dashscope / suno-compatible
MUSIC_PROVIDER=
# MUSIC_API_KEY=
# MUSIC_BASE_URL=
# MUSIC_MODEL=

# 云端 TTS：dashscope / minimax / fish-audio / openai-compatible / gemini / xiaomi-mimo
VOICE_PROVIDER=
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_MODEL=
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 小米 MiMo TTS（OpenAI 兼容 chat/completions）
# MIMO_API_KEY=
# 预置音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=mimo_default
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
#
# 固定音色 + 每条视频换风格（推荐）：voicedesign 生成一次参考样本，之后 voiceclone。
# MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
# MIMO_VOICE_PROFILE=voices/tech-male-m2
# MIMO_TTS_VOICE=
# MIMO_STYLE_PROMPT=像刚开完会的科技博主，和同事面对面讲清楚一件事。语速正常偏快，句与句之间自然换气，句尾收住，不要播音腔，不要广告腔。
# 每条视频也可用 `tts.py speak --style "冷静拆解：..."` 临时覆盖风格。
#
# profile 目录里的 voice.json 示例：
# {
#   "name": "tech-male-m2",
#   "provider": "xiaomi-mimo",
#   "model": "mimo-v2.5-tts-voiceclone",
#   "design_prompt": "二十八岁左右的男性技术博主，声音清亮、偏薄……",
#   "reference": "reference.mp3",
#   "default_style": "像刚开完会的科技博主……"
# }
#
# 要直接用音色设计模型（无需样本）：
# MIMO_TTS_MODEL=mimo-v2.5-tts-voicedesign
# MIMO_TTS_VOICE=三十岁出头、普通话带轻微南方口音、声音偏沙哑、语速中等偏慢的男声
# 要复刻本人音色（需 mp3/wav 样本）：
# MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
# MIMO_VOICE_SAMPLE=path/to/voice.mp3
#
# 导演指令：像给演员写舞台提示，放在 user message，不会被朗读。
# 实测要点：**短比长好**。堆满「不要播音腔/不要广告腔」的长指令会让模型过度表演，
# 停顿被拉长到 650ms、时长涨 10%（200 字 vs 60 字，同一段稿子的对比）。
# 只说「做什么」，别堆「不要什么」。
# MIMO_STYLE_PROMPT=你在跟同事讲一个技术判断。不是朗读，是说话。句尾自然落下，别每句都收成同一个弧线；列举时平推，转折处停一下，反问带点笑意。允许换气和不完美。
#
# 口播稿去 AI 味靠两条通道配合（详见 tts-voiceover SKILL）：
#   ① 段落调性 → 正文行首写 (自然 口语 略带兴奋)，只作用于紧跟的段落
#   ② 音频标签 → 正文任意位置内嵌 [停顿] [语速加快] [长叹一口气] [轻笑]
#      标签会被执行、不会被念出来；写错标签会被当正文朗读，用 voice_script.py check 校验
#      用量约每百字 2 个，逐句堆会变成话剧腔
#   ③ 口音/音色质感 → 可试 (东北话) (四川话) (河南话) (粤语)，或 (沙哑) (磁性) (醇厚)

# 语音转写 ASR：auto / local / xiaomi-mimo / siliconflow（设置页点“主”会写入）
TRANSCRIBE_PROVIDER=
# 小米 MiMo ASR（复用 MIMO_API_KEY；OpenAI 兼容 chat/completions）
# MIMO_ASR_MODEL=mimo-v2.5-asr
# 硅基流动 ASR
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_ASR_MODEL=SenseVoiceSmall

# 多个媒体能力可复用同一份 DashScope key
# DASHSCOPE_API_KEY=
