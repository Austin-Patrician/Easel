# ============================================================
# Easel 环境变量
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# 人工发布模式：automated（允许一键发布）或 manual（只导出人工发布包）
EASEL_PUBLISH_MODE=automated

# Web 服务监听地址（默认只绑本机）
# EASEL_HOST=127.0.0.1
# EASEL_PORT=7860

# pi 是唯一 Agent 底座。模型认证优先用 pi 自己的登录：
#   pi
#   /login
# 也可以填入任意 OpenAI-compatible 服务，Easel 会注册为 pi provider `easel-direct`。
# EASEL_DIRECT_API_KEY=REPLACE_ME
# EASEL_DIRECT_API_BASE_URL=https://your-provider.example/v1
# EASEL_DIRECT_API_MODEL=gpt-4.1
# 可选：API Key 请求头（默认 Authorization: Bearer <key>）
# EASEL_DIRECT_API_KEY_HEADER=api-key

# 媒体生成脚本也可复用 OpenAI-compatible 服务
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 可选：独立向量/Embedding API（不配置则使用关键词记忆检索）
# EASEL_EMBEDDING_API_KEY=REPLACE_ME
# EASEL_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EASEL_EMBEDDING_MODEL=text-embedding-3-small

# 代理（仅用于外部平台抓取和发布；本地 pi 服务不应经过代理）
# EASEL_PROXY=http://127.0.0.1:7890

# ============================================================
# 可选：媒体生成模型（也可在 Web 设置中填写）
# 只需配置实际使用的 provider；密钥留空不会启用。
# ============================================================

# 视频：dashscope / ark / kling / openai-compatible / xhs-maas / agnes
VIDEO_PROVIDER=
# AGNES_API_KEY=
# AGNES_MODEL=agnes-video-2.5-flash
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# AI 音乐：dashscope / suno-compatible
MUSIC_PROVIDER=
# MUSIC_API_KEY=
# MUSIC_BASE_URL=
# MUSIC_MODEL=

# 云端 TTS：dashscope / minimax / fish-audio / openai-compatible / gemini / xiaomi-mimo
VOICE_PROVIDER=
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_MODEL=
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 小米 MiMo TTS（OpenAI 兼容 chat/completions；预置音色）
# MIMO_API_KEY=
# MIMO_TTS_MODEL=mimo-v2.5-tts
# 预置音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
# MIMO_TTS_VOICE=mimo_default
# 导演提示词：自然语言描述音色、节奏、停顿、重音；放在 user message，不会被朗读
# MIMO_STYLE_PROMPT=【角色】你是“长话短说”的主理人：做 Agent 开发的一线工程师、开源项目维护者。说话结论先行，信息密度高，坦白、克制、有判断，不装权威，不喊口号，也不像营销号。【场景】你正在会议室白板前，给 25-35 岁的职场人和独立开发者复盘一个 AI 产品/模型。对方懂一点技术，但没耐心听铺垫，你要像同事之间讲清楚一件事，而不是在录音棚朗诵。【指导】语速正常偏慢半拍；判断句、数字、版本号、对比词前后留半拍，让听众跟上；逗号短停，分号和段落转折处明显停，列表逐条分开，不要连读。句尾自然落下，不要每句上扬；重点只落在结论、数字和反差上，不要平均用力。整体克制，只在“这里有个坑”和“所以结论是”两处稍微加力；遇到自嘲或反问，带一点很轻的笑意，但不要笑出声。允许轻微换气和口语停顿，但不要夸张气声、不要播音腔、不要广告腔。英文术语（Agent、MCP、API、GPT、DeepSeek 等）按技术圈口语自然读，不要逐字母念，也不要字正腔圆地念。
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 语音转写 ASR：auto / local / xiaomi-mimo / siliconflow（设置页点“主”会写入）
TRANSCRIBE_PROVIDER=
# 小米 MiMo ASR（复用 MIMO_API_KEY；OpenAI 兼容 chat/completions）
# MIMO_ASR_MODEL=mimo-v2.5-asr
# 硅基流动 ASR
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_ASR_MODEL=SenseVoiceSmall

# 多个媒体能力可复用同一份 DashScope key
# DASHSCOPE_API_KEY=
